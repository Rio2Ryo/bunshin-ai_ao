# ============================================
# Bunshin AI — Environment Variables
# ============================================
# Copy this file to .dev.vars for local development
# Production secrets are set via: wrangler secret put KEY

# ---- Required ----
JWT_SECRET=your-jwt-secret-here

# ---- LLM (at least one required for AI features) ----
# Azure AI Foundry (default server-side LLM)
AZURE_FOUNDRY_API_KEY=your-azure-foundry-key
AZURE_FOUNDRY_RESOURCE=your-azure-resource-name

# ---- Stripe Billing (optional) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Email (optional — Resend API) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@your-domain.com
FRONTEND_URL=https://bunshin-ai.pages.dev

# ---- LINE Integration (optional) ----
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-access-token
LINE_DEBUG_MODE=false

# ---- Web Push (optional) ----
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ---- Clawdbot Gateway (optional) ----
CLAWDBOT_GATEWAY_URL=https://your-clawdbot-gateway.com
CLAWDBOT_AUTH_TOKEN=your-clawdbot-auth-token
CLAWDBOT_AGENT_ID=main

# ---- External AI APIs (optional — users can also set their own) ----
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# GROK_API_KEY=...

# ---- Slack Notifications (optional) ----
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# ---- Tavily Web Search (optional) ----
# TAVILY_API_KEY=tvly-...

# ---- Frontend (Vite) ----
VITE_API_BASE=http://localhost:8787
# VITE_APP_TITLE=分身AI
